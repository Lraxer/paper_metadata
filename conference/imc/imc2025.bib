                  Alberto Dainotti},
	title = {Poster: ECN-based Congestion Control for WebRTC},
	booktitle = {Proceedings of the 2025 {ACM} Internet Measurement Conference, {IMC}
                  2025, Madison, WI, USA, 28-31 October 2025},
	pages = {1038--1039},
	publisher = {{ACM}},
	year = {2025},
	url = {https://doi.org/10.1145/3730567.3768595},
	doi = {10.1145/3730567.3768595},
	timestamp = {Wed, 25 Feb 2026 08:26:34 +0100},
	biburl = {https://dblp.org/rec/conf/imc/AshhabK25.bib},
	bibsource = {dblp computer science bibliography, https://dblp.org},
	abstract = {Real-time communication (RTC) applications require low packet delay and loss while maintaining a stable throughput. WebRTC, a widely used framework, relies on Google Congestion Control (GCC). Meanwhile, newer methods like L4S (Low Latency, Low Loss, Scalable Throughput) provide opportunities with early congestion signaling. In this work, we extend client-side WebRTC to support L4S by adding ECN-based rate control and ECN feedback handling. Our results show that L4S improves real-time performance while remaining compatible with current WebRTC infrastructure.}
}


