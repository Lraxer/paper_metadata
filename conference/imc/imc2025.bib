	biburl = {https://dblp.org/rec/conf/imc/BoianoPMCZSR025.bib},
	bibsource = {dblp computer science bibliography, https://dblp.org},
	abstract = {The rollout of 5G promises major improvements in speed, latency, and connectivity over previous-generation radio access technologies. Our study analyzes Orange's nationwide 5G network in France, combining longitudinal data on infrastructure deployment with data traffic patterns. Early results show that while 5G coverage has steadily expanded and is presently reaching the vast majority of the user population, adoption by mobile subscribers remains limited, leaving much of the new capacity underutilized.}
}


@inproceedings{DBLP:conf/imc/ChandrasekaranD25,
	author = {Sanjay Chandrasekaran and
                  Jaber Daneshamooz and
                  Oliver Michel and
                  Arpit Gupta},
	editor = {Paul Barford and
                  Aruna Balasubramanian and
                  Alberto Dainotti},
