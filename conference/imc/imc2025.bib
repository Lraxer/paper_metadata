	biburl = {https://dblp.org/rec/conf/imc/ChoH25.bib},
	bibsource = {dblp computer science bibliography, https://dblp.org},
	abstract = {How do VPNs interact with IPv6? Our poster shows that VPNs often leak IPv6 traffic, failing to provide the promised privacy, and VPNs often prefer IPv4, even though IPv6 is available and working. These results use new data from a website for IP identification, coupled with experiments on specific VPN software. We identify the fraction of v6 traffic leaked, and find the root-cause of IPv6 de-preferencing in interactions between address selection in OSes and VPNs}
}


@inproceedings{DBLP:conf/imc/GatsiRMSG25,
	author = {Francis A. Gatsi and
                  Muhammad Iqbal Rochman and
                  Saeid Mehrdad and
                  Aaron D. Striegel and
                  Monisha Ghosh},
	editor = {Paul Barford and
                  Aruna Balasubramanian and
                  Alberto Dainotti},
	title = {Poster: Measurements of Residential Broadband in a Midwest Town: Discerning
                  Wi-Fi Performance Factors},
	booktitle = {Proceedings of the 2025 {ACM} Internet Measurement Conference, {IMC}
                  2025, Madison, WI, USA, 28-31 October 2025},
	pages = {1050--1051},
	publisher = {{ACM}},
	year = {2025},
	url = {https://doi.org/10.1145/3730567.3768610},
	doi = {10.1145/3730567.3768610},
	timestamp = {Wed, 25 Feb 2026 08:26:34 +0100},
	biburl = {https://dblp.org/rec/conf/imc/GatsiRMSG25.bib},
	bibsource = {dblp computer science bibliography, https://dblp.org},
	abstract = {Understanding the real-world end-to-end performance of residential Wi-Fi and broadband networks is essential for consumers, service providers, and policy makers in an increasingly connected society to determine how connectivity can be improved, through better technology or appropriate spectrum decisions. While previous research has studied such performance, the focus has primarily been on the wired Internet, pointing to Wi-Fi as a bottleneck without investigating the reasons thereof. We believe that the preliminary results presented in this paper, from in-depth studies of residential Wi-Fi deployments in a small Midwestern town, offer a first look into how the Wi-Fi environment may impact the user experience. Over a period of six months, we deployed single-board computers to measure the throughput and latency of Wi-Fi and the backhaul broadband network in a number of different residential environments, as well as capture the Wi-Fi signal environment. Our analyses show: (i) interoperability issues between AP and client supporting different Wi-Fi amendments ( e.g. , 802.11ac, 802.11ax); (ii) a lack of smart interference management and Dynamic Frequency Selection (DFS) support, resulting in over-usage of channels in the U-NII-1 and U-NII-3 bands when other, less congested bands may be available.}
}


@inproceedings{DBLP:conf/imc/Gong00SWCD00WE025,
	author = {Wenwen Gong and
                  Lin He and
                  Hongwei Li and
                  Guanglei Song and
                  Wentong Wang and
                  Daguo Cheng and
                  Enhuan Dong and
                  Chenglong Li and
                  Hui Zhang and
                  Zhiliang Wang and
                  Jinlong E and
                  Ying Liu and
                  Jiahai Yang},
	editor = {Paul Barford and
                  Aruna Balasubramanian and
                  Alberto Dainotti},
	title = {Poster: TopoHunter: Enabling Efficient and High-Coverage Active IPv6
                  Topology Discovery},
	booktitle = {Proceedings of the 2025 {ACM} Internet Measurement Conference, {IMC}
                  2025, Madison, WI, USA, 28-31 October 2025},
	pages = {1052--1053},
	publisher = {{ACM}},
	year = {2025},
	url = {https://doi.org/10.1145/3730567.3768591},
	doi = {10.1145/3730567.3768591},
	timestamp = {Thu, 05 Mar 2026 17:17:16 +0100},
	biburl = {https://dblp.org/rec/conf/imc/Gong00SWCD00WE025.bib},
	bibsource = {dblp computer science bibliography, https://dblp.org},
	abstract = {We introduce TopoHunter, an efficient IPv6 Internet topology discovery system. The central concept of TopoHunter is to allocate more probing resources to target prefix spaces that yield greater topological benefits, as well as to their surrounding areas. To achieve this, we design a feedback-based target generation module comprised of a  Target Prefix Probing Value Forest  that maintains the estimated probing values of hierarchical target prefix spaces. Our system has successfully discovered the most extensive and complete IPv6 topology map to date, comprising over 144 million router interfaces and 251 million edges, covering 72.83% of autonomous systems and 43.36% of routing prefixes announced by the BGP system.}
}


@inproceedings{DBLP:conf/imc/HahnO025,
	author = {Nathaniel Hahn and
                  Tu Ouyang and
                  An Wang},
	editor = {Paul Barford and
                  Aruna Balasubramanian and
                  Alberto Dainotti},
	title = {Poster: Measuring Algorithmic Systems' Resilience Against Generative
                  AI-Powered Attacks - Case Study on Exploiting a Code Search Platform},
	booktitle = {Proceedings of the 2025 {ACM} Internet Measurement Conference, {IMC}
                  2025, Madison, WI, USA, 28-31 October 2025},
	pages = {1054--1055},
	publisher = {{ACM}},
	year = {2025},
	url = {https://doi.org/10.1145/3730567.3768590},
	doi = {10.1145/3730567.3768590},
	timestamp = {Thu, 05 Mar 2026 17:17:16 +0100},
	biburl = {https://dblp.org/rec/conf/imc/HahnO025.bib},
	bibsource = {dblp computer science bibliography, https://dblp.org},
	abstract = {Generative AI applications have boomed since the GPT-3-powered ChatGPT release in 2022. Miscreants also see the opportunities of leveraging these frontier GenAI technologies to facilitate cyberattacks, from planning to execution. These GenAI-powered attacks can pose a significant threat to existing and emerging algorithmic systems, including information search platforms, ranking, and recommender systems. It is vital to study and measure the vulnerabilities of existing algorithmic systems against misused GenAI-powered capabilities and thus guide the defense design of future algorithmic systems, similar to those used in traditional security red teaming. It is particularly challenging because the landscape of GenAI has been under constant and rapid change in recent years. As a preliminary to a comprehensive measurement study, we showcase an attack powered by the in-context learning capabilities of large language models, aiming to manipulate the ranking of a code search platform and inject malicious code snippets. Our GenAI attack achieves 59.2% injection success rate against SourceGraph's Cody platform using 245 developer queries. The generated adversarial code snippets reach top-10 rankings in 29.8% of cases despite containing deliberate security vulnerabilities, performance bottlenecks, or logic errors.}
}


